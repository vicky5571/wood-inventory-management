# ==============================================================================
# Environment Configuration Template (SSOT)
# Copy this file to .env.local and update with your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration
# Sourced from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct PostgreSQL Database Connection String
# Sourced from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security
# Min 32 characters random secret for Iron Session / JWT cookie encryption
# ------------------------------------------------------------------------------
SESSION_SECRET=wood-inventory-development-secret-key-32chars-min

# ------------------------------------------------------------------------------
# 3. Local SQLite & Fallback Storage (Optional Overrides)
# ------------------------------------------------------------------------------
WOOD_DB_PATH=data/wood_inventory.db
WOOD_RECORDS_PATH=data/wood_records.json
