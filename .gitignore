# ==============================================================================
# Git Ignore Configuration
# Sourced from GitHub Official Templates (Node.js, macOS, Windows, Linux, Editors)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependency Directories & Package Managers
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/

# Yarn
.pnp
.pnp.*
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn-integrity

# pnpm & npm
.pnpm-store/
.npm

# ------------------------------------------------------------------------------
# 2. Build Artifacts & Output
# ------------------------------------------------------------------------------
dist/
build/
build/Release
out/
.output/

# TypeScript Cache
*.tsbuildinfo

# Package Tarballs
*.tgz

# ------------------------------------------------------------------------------
# 3. Testing & Coverage
# ------------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output
lib-cov/

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template

# ------------------------------------------------------------------------------
# 5. Logs & Runtime Diagnostic Data
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (Node.js)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime process data
pids/
*.pid
*.seed
*.pid.lock
.node_repl_history

# ------------------------------------------------------------------------------
# 6. Tooling, Bundlers & Framework Caches
# ------------------------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.prettiercache
.turbo/
.lock-wscript

# Framework-specific caches (Next.js, Nuxt, Vite, Svelte, Astro, Docusaurus)
.next/
.nuxt/
.svelte-kit/
.docusaurus/
.astro/
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vuepress/dist
.temp
**/.vitepress/dist
**/.vitepress/cache

# Serverless & Cloud Emulators
.serverless/
.fusebox/
.dynamodb/
.firebase/

# ------------------------------------------------------------------------------
# 7. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ------------------------------------------------------------------------------
# 8. IDEs & Code Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!*.code-workspace
.vscode-test/
*.vsix

# JetBrains (IntelliJ, WebStorm, PhpStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs backup and swap files
*.swp
*.swo
\#*\#
